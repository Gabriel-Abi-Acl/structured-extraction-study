    },
    "order_date": {
      "type": ["string", "null"]
    },
    "amount_brl": {
      "type": ["string", "null"]
    },
    "city": {
      "type": ["string", "null"]
    },
    "item": {
      "type": ["string", "null"]
    }
  }
